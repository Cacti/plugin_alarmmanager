[Unit]
Description=Cacti Alarm Manager signed history sender (remote collector)
After=network.target mariadb.service

[Service]
Type=oneshot
User=cacti
Group=cacti
WorkingDirectory=/var/www/html/cacti/plugins/alarmmanager
# Bounded batch; the timer interval sets the transfer cadence.
ExecStart=/usr/bin/php cli/remote.php --send --limit=100
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target