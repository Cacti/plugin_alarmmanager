[Unit]
Description=Cacti Alarm Manager daemon (processing and delivery workers)
After=network.target mariadb.service

[Service]
Type=simple
User=cacti
Group=cacti
WorkingDirectory=/var/www/html/cacti/plugins/alarmmanager
ExecStart=/usr/bin/php alarmmanager_daemon.php --config=/etc/cacti/alarmmanager-workers.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=195
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target