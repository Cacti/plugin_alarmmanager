#: alarmmanager_admin.php:50
msgid "The administration action succeeded."
msgstr "Η ενέργεια διαχείρισης ολοκληρώθηκε με επιτυχία."

#: alarmmanager_admin.php:86
msgid "Administration unavailable or permission denied."
msgstr "Η διαχείριση δεν είναι διαθέσιμη ή δεν επιτρέπεται η πρόσβαση."

#: includes/admin_view.php:78
msgid "Choose the alarm information to send to any service. Use Combined text to arrange device details, or Use device message to start with a complete message. Email uses Subject and Message; API destinations use the field names required by the receiving service."
msgstr "Επιλέξτε τις πληροφορίες συναγερμού που θα αποστέλλονται σε οποιαδήποτε υπηρεσία. Χρησιμοποιήστε Συνδυασμένο κείμενο για να οργανώσετε τις λεπτομέρειες της συσκευής ή Χρήση μηνύματος συσκευής για να ξεκινήσετε με ένα πλήρες μήνυμα. Το email χρησιμοποιεί Θέμα και Μήνυμα. Οι προορισμοί API χρησιμοποιούν τα ονόματα πεδίων που απαιτεί η υπηρεσία παραλαβής."

#: includes/admin_view.php:79
msgid "Advanced message configuration"
msgstr "Σύνθετη διαμόρφωση μηνύματος"

#: includes/admin_view.php:90
msgid "New endpoint"
msgstr "Νέο τελικό σημείο"

#: includes/admin_view.php:100
msgid "Custom integration"
msgstr "Προσαρμοσμένη ενσωμάτωση"

#: includes/admin_view.php:100
msgid "Integration provider"
msgstr "Πάροχος ενσωμάτωσης"

#: includes/admin_view.php:112
msgid "API Key SID and Secret (recommended)"
msgstr "API Key SID και Secret (προτείνεται)"

#: includes/admin_view.php:112
msgid "Account SID and Auth Token"
msgstr "Account SID και Auth Token"

#: includes/admin_view.php:112
msgid "Twilio credentials"
msgstr "Διαπιστευτήρια Twilio"

#: includes/admin_view.php:113
msgid "Send using"
msgstr "Αποστολή με χρήση"

#: includes/admin_view.php:125
msgid "Event"
msgstr "Συμβάν"

#: includes/admin_view.php:125
msgid "Incident"
msgstr "Περιστατικό"

#: includes/admin_view.php:125
msgid "ServiceNow record type"
msgstr "Τύπος εγγραφής ServiceNow"

#: includes/admin_view.php:126
msgid "Changing the record type replaces the destination table, message fields and recovery settings with its defaults. Your instance and credentials are retained."
msgstr "Η αλλαγή του τύπου εγγραφής αντικαθιστά τον πίνακα προορισμού, τα πεδία μηνύματος και τις ρυθμίσεις αποκατάστασης με τις προεπιλογές του. Η παρουσία και τα διαπιστευτήριά σας διατηρούνται."

#: includes/admin_view.php:149
msgid "Destination"
msgstr "Προορισμός"

#: includes/admin_view.php:154
msgid "Email settings"
msgstr "Ρυθμίσεις email"

#: includes/admin_view.php:161
msgid "Delivery uses the Cacti mail settings. Add the people who should receive these alarms."
msgstr "Η παράδοση χρησιμοποιεί τις ρυθμίσεις email του Cacti. Προσθέστε τα άτομα που πρέπει να λαμβάνουν αυτούς τους συναγερμούς."

#: includes/admin_view.php:162
msgid "Script settings"
msgstr "Ρυθμίσεις σεναρίου"

#: includes/admin_view.php:167
msgid "JSON output is sent to the script on standard input."
msgstr "Η έξοδος JSON αποστέλλεται στο σενάριο μέσω της τυπικής εισόδου."

#: includes/admin_view.php:167
msgid "The executable must exist and be executable by the worker on every delivering poller. Arguments are passed directly without a shell."
msgstr "Το εκτελέσιμο αρχείο πρέπει να υπάρχει και να είναι εκτελέσιμο από τον worker σε κάθε poller παράδοσης. Τα ορίσματα μεταβιβάζονται απευθείας χωρίς κέλυφος."

#: includes/admin_view.php:169
msgid "WebSocket delivery is not implemented."
msgstr "Η παράδοση WebSocket δεν έχει υλοποιηθεί."

#: includes/admin_view.php:171
msgid "Advanced delivery settings"
msgstr "Σύνθετες ρυθμίσεις παράδοσης"

#: includes/admin_view.php:176
msgid "Connection options"
msgstr "Επιλογές σύνδεσης"

#: includes/admin_view.php:179
msgid "Method"
msgstr "Μέθοδος"

#: includes/admin_view.php:186
msgid "Certificate and hostname verification remain enabled. Provision the PEM file on every poller. Saved credentials are never displayed."
msgstr "Η επαλήθευση πιστοποιητικού και ονόματος κεντρικού υπολογιστή παραμένει ενεργοποιημένη. Τοποθετήστε το αρχείο PEM σε κάθε poller. Τα αποθηκευμένα διαπιστευτήρια δεν εμφανίζονται ποτέ."

#: includes/admin_view.php:187
msgid "Other delivery options"
msgstr "Άλλες επιλογές παράδοσης"

#: includes/admin_view.php:189 includes/admin_view.php:458
msgid "Cancel"
msgstr "Ακύρωση"

#: includes/admin_view.php:189
msgid "Test destination saves the current settings and queues a sample alarm for this destination. Enable the destination before testing."
msgstr "Η Δοκιμή προορισμού αποθηκεύει τις τρέχουσες ρυθμίσεις και τοποθετεί στην ουρά έναν δοκιμαστικό συναγερμό για αυτόν τον προορισμό. Ενεργοποιήστε τον προορισμό πριν τη δοκιμή."

#: includes/admin_view.php:190
msgid "Save endpoint"
msgstr "Αποθήκευση τελικού σημείου"

#: includes/admin_view.php:190
msgid "Test destination"
msgstr "Δοκιμή προορισμού"

#: includes/admin_view.php:194
msgid "Delete endpoint"
msgstr "Διαγραφή τελικού σημείου"

#: includes/admin_view.php:194
msgid "Delete this endpoint, its delivery settings and saved credentials"
msgstr "Διαγραφή αυτού του τελικού σημείου, των ρυθμίσεων παράδοσης και των αποθηκευμένων διαπιστευτηρίων του"

#: includes/admin_view.php:194
msgid "Deleting stops future delivery and removes the saved settings and credentials. Remove notification rule references and resolve queued or running deliveries first. Completed and failed delivery history is preserved."
msgstr "Η διαγραφή διακόπτει τις μελλοντικές παραδόσεις και καταργεί τις αποθηκευμένες ρυθμίσεις και τα διαπιστευτήρια. Καταργήστε πρώτα τις αναφορές στους κανόνες ειδοποίησης και επιλύστε τις παραδόσεις που βρίσκονται στην ουρά ή σε εκτέλεση. Το ιστορικό ολοκληρωμένων και αποτυχημένων παραδόσεων διατηρείται."

#: includes/admin_view.php:205
msgid "Chat and messaging"
msgstr "Συνομιλία και μηνύματα"

#: includes/admin_view.php:206
msgid "Post alarms to a Slack channel."
msgstr "Δημοσίευση συναγερμών σε κανάλι Slack."

#: includes/admin_view.php:207
msgid "Post alarm cards through a Teams Workflow."
msgstr "Δημοσίευση καρτών συναγερμού μέσω Teams Workflow."

#: includes/admin_view.php:208
msgid "Send alarms from a Telegram bot."
msgstr "Αποστολή συναγερμών από bot Telegram."

#: includes/admin_view.php:209
msgid "Text alarms to phone numbers."
msgstr "Αποστολή SMS συναγερμών σε αριθμούς τηλεφώνου."

#: includes/admin_view.php:210
msgid "Send approved WhatsApp templates."
msgstr "Αποστολή εγκεκριμένων προτύπων WhatsApp."

#: includes/admin_view.php:211
msgid "Incident management"
msgstr "Διαχείριση περιστατικών"

#: includes/admin_view.php:212
msgid "Trigger and resolve PagerDuty incidents."
msgstr "Ενεργοποίηση και επίλυση περιστατικών PagerDuty."

#: includes/admin_view.php:213
msgid "Open and resolve ServiceNow incidents or events."
msgstr "Άνοιγμα και επίλυση περιστατικών ή συμβάντων ServiceNow."

#: includes/admin_view.php:214
msgid "Network management"
msgstr "Διαχείριση δικτύου"

#: includes/admin_view.php:215
msgid "Send SNMPv2c or SNMPv3 traps and INFORMs."
msgstr "Αποστολή SNMPv2c ή SNMPv3 traps και INFORMs."

#: includes/admin_view.php:216
msgid "Forward RFC 5424 or RFC 3164 messages over UDP, TCP or TLS."
msgstr "Προώθηση μηνυμάτων RFC 5424 ή RFC 3164 μέσω UDP, TCP ή TLS."

#: includes/admin_view.php:217
msgid "Custom"
msgstr "Προσαρμογή"

#: includes/admin_view.php:218
msgid "Start from an empty endpoint."
msgstr "Ξεκινήστε από ένα κενό τελικό σημείο."

#: includes/admin_view.php:219
msgid "POST alarm JSON to any HTTPS endpoint."
msgstr "Αποστολή JSON συναγερμού με POST σε οποιοδήποτε τελικό σημείο HTTPS."

#: includes/admin_view.php:220
msgid "Call an API with your own method, authentication and response checks."
msgstr "Κλήση ενός API με τη δική σας μέθοδο, έλεγχο ταυτότητας και ελέγχους απόκρισης."

#: includes/admin_view.php:221
msgid "Run a local executable with the alarm as JSON input."
msgstr "Εκτέλεση τοπικού εκτελέσιμου αρχείου με τον συναγερμό ως είσοδο JSON."

#: includes/admin_view.php:227
msgid "Add integration"
msgstr "Προσθήκη ενσωμάτωσης"

#: includes/admin_view.php:228
msgid "Choose a template. It opens as a disabled draft; nothing is sent until you enable it."
msgstr "Επιλέξτε ένα πρότυπο. Ανοίγει ως απενεργοποιημένο πρόχειρο. Δεν αποστέλλεται τίποτα μέχρι να το ενεργοποιήσετε."

#: includes/admin_view.php:228
msgid "Search integrations"
msgstr "Αναζήτηση ενσωματώσεων"

#: includes/admin_view.php:234
msgid "Blank endpoint"
msgstr "Κενό τελικό σημείο"

#: includes/admin_view.php:239
msgid "No integrations match your search."
msgstr "Καμία ενσωμάτωση δεν ταιριάζει με την αναζήτησή σας."

#: includes/admin_view.php:243
msgid "SNMP trap settings"
msgstr "Ρυθμίσεις SNMP trap"

#: includes/admin_view.php:259
msgid "Saved community and passphrases are encrypted and never displayed. Leave them blank to keep the saved values; entering any value replaces all saved SNMP secrets."
msgstr "Η αποθηκευμένη κοινότητα και οι φράσεις πρόσβασης είναι κρυπτογραφημένες και δεν εμφανίζονται ποτέ. Αφήστε τα κενά για να διατηρήσετε τις αποθηκευμένες τιμές. Η εισαγωγή οποιασδήποτε τιμής αντικαθιστά όλα τα αποθηκευμένα μυστικά SNMP."

#: includes/admin_view.php:260
msgid "Traps are sent as Cacti's CACTI-MIB cactiNotify with the snmptrap binary from Cacti Settings > Paths on every delivering poller. Add one destination per receiver."
msgstr "Τα traps αποστέλλονται ως CACTI-MIB cactiNotify του Cacti με το εκτελέσιμο snmptrap από τις Ρυθμίσεις Cacti > Διαδρομές σε κάθε poller παράδοσης. Προσθέστε έναν προορισμό ανά παραλήπτη."

#: includes/admin_view.php:261
msgid "Syslog settings"
msgstr "Ρυθμίσεις Syslog"

#: includes/admin_view.php:269
msgid "TLS verifies the receiver certificate and hostname. Use port 6514 for TLS. UDP and TCP are unencrypted, and a UDP message is confirmed only as sent."
msgstr "Το TLS επαληθεύει το πιστοποιητικό και το όνομα κεντρικού υπολογιστή του παραλήπτη. Χρησιμοποιήστε τη θύρα 6514 για TLS. Τα UDP και TCP δεν είναι κρυπτογραφημένα και ένα μήνυμα UDP επιβεβαιώνεται μόνο ως απεσταλμένο."

#: includes/admin_view.php:278 setup.php:191
msgid "Days"
msgstr "Ημέρες"

#: includes/admin_view.php:283
msgid "Timezone"
msgstr "Ζώνη ώρας"

#: includes/admin_view.php:291
msgid "Times use the selected timezone and the alarm event time. An end time before the start runs overnight. Equal times cover the entire selected day."
msgstr "Οι ώρες χρησιμοποιούν την επιλεγμένη ζώνη ώρας και την ώρα του συμβάντος συναγερμού. Μια ώρα λήξης πριν από την έναρξη εκτείνεται κατά τη διάρκεια της νύχτας. Ίσες ώρες καλύπτουν ολόκληρη την επιλεγμένη ημέρα."

#: includes/admin_view.php:332 includes/admin_view.php:521
msgid "Create a rule"
msgstr "Δημιουργία κανόνα"

#: includes/admin_view.php:332
msgid "Enabled"
msgstr "Ενεργοποιημένο"

#: includes/admin_view.php:332
msgid "Priority"
msgstr "Προτεραιότητα"

#: includes/admin_view.php:334
msgid "Rule and destination"
msgstr "Κανόνας και προορισμός"

#: includes/admin_view.php:338
msgid "Alarm Destination"
msgstr "Προορισμός συναγερμού"

#: includes/admin_view.php:341
msgid "disabled"
msgstr "απενεργοποιημένο"

#: includes/admin_view.php:343
msgid "Select one or more alarm destinations. Disabled destinations do not send alarms."
msgstr "Επιλέξτε έναν ή περισσότερους προορισμούς συναγερμού. Οι απενεργοποιημένοι προορισμοί δεν αποστέλλουν συναγερμούς."

#: includes/admin_view.php:345
msgid "Message template"
msgstr "Πρότυπο μηνύματος"

#: includes/admin_view.php:345
msgid "Use each destination default, or customize its message for this rule. Customization starts with a copy of the destination template and does not change other rules. If several rules match the same destination, the first matching rule in priority and ID order supplies its template."
msgstr "Χρησιμοποιήστε την προεπιλογή κάθε προορισμού ή προσαρμόστε το μήνυμά του για αυτόν τον κανόνα. Η προσαρμογή ξεκινά από ένα αντίγραφο του προτύπου προορισμού και δεν αλλάζει άλλους κανόνες. Εάν πολλοί κανόνες ταιριάζουν με τον ίδιο προορισμό, ο πρώτος αντίστοιχος κανόνας κατά σειρά προτεραιότητας και αναγνωριστικού παρέχει το πρότυπό του."

#: includes/admin_view.php:352
msgid "Custom template"
msgstr "Προσαρμοσμένο πρότυπο"

#: includes/admin_view.php:355
msgid "Destination recipient"
msgstr "Παραλήπτης προορισμού"

#: includes/admin_view.php:355
#, php-format
msgid "Recipients: %d"
msgstr "Παραλήπτες: %d"

#: includes/admin_view.php:357
msgid "Customize message for this rule"
msgstr "Προσαρμογή μηνύματος για αυτόν τον κανόνα"

#: includes/admin_view.php:357
msgid "Unchecked: Use destination default."
msgstr "Ανεπιλεγμένο: Χρήση προεπιλογής προορισμού."

#: includes/admin_view.php:361
msgid "Optional: add each phone number in international format, such as +15551234567. These numbers replace the destination recipient for this rule. Leave the list empty to use the destination default. Each number has its own delivery status and retries."
msgstr "Προαιρετικό: προσθέστε κάθε αριθμό τηλεφώνου σε διεθνή μορφή, όπως +15551234567. Αυτοί οι αριθμοί αντικαθιστούν τον παραλήπτη προορισμού για αυτόν τον κανόνα. Αφήστε τη λίστα κενή για να χρησιμοποιηθεί η προεπιλογή του προορισμού. Κάθε αριθμός έχει τη δική του κατάσταση παράδοσης και επαναλήψεις."

#: includes/admin_view.php:374
msgid "None"
msgstr "Κανένα"

#: includes/admin_view.php:376
msgid "Build device conditions using AND, OR and groups. These conditions use the current Cacti device settings and must also satisfy any alarm filters below. With no device conditions, all devices can match."
msgstr "Δημιουργήστε συνθήκες συσκευής χρησιμοποιώντας AND, OR και ομάδες. Αυτές οι συνθήκες χρησιμοποιούν τις τρέχουσες ρυθμίσεις συσκευής Cacti και πρέπει επίσης να πληρούν τυχόν φίλτρα συναγερμού παρακάτω. Χωρίς συνθήκες συσκευής, μπορούν να ταιριάξουν όλες οι συσκευές."

#: includes/admin_view.php:376
msgid "Match devices"
msgstr "Αντιστοίχιση συσκευών"

#: includes/admin_view.php:387
msgid "Cacti_Admin_Notifications"
msgstr "Cacti_Admin_Notifications"

#: includes/admin_view.php:387
msgid "Device Status"
msgstr "Κατάσταση συσκευής"

#: includes/admin_view.php:387
msgid "Syslog"
msgstr "Syslog"

#: includes/admin_view.php:387
msgid "Thold"
msgstr "Thold"

#: includes/admin_view.php:392
msgid "Build alarm conditions using AND, OR, NOT and groups. Alarms must also match the device conditions above."
msgstr "Δημιουργήστε συνθήκες συναγερμού χρησιμοποιώντας AND, OR, NOT και ομάδες. Οι συναγερμοί πρέπει επίσης να ταιριάζουν με τις παραπάνω συνθήκες συσκευής."

#: includes/admin_view.php:392
msgid "Match alarms"
msgstr "Αντιστοίχιση συναγερμών"

#: includes/admin_view.php:395
msgid "No alarm sources detected yet. Sources appear after their first alarm."
msgstr "Δεν έχουν εντοπιστεί ακόμη πηγές συναγερμών. Οι πηγές εμφανίζονται μετά τον πρώτο τους συναγερμό."

#: includes/admin_view.php:397
msgid "By default, matching alarms can notify at any time. Turn on a schedule to limit when this rule matches."
msgstr "Από προεπιλογή, οι αντίστοιχοι συναγερμοί μπορούν να ειδοποιούν οποιαδήποτε στιγμή. Ενεργοποιήστε ένα χρονοδιάγραμμα για να περιορίσετε πότε εφαρμόζεται αυτός ο κανόνας."

#: includes/admin_view.php:397
msgid "Notification hours"
msgstr "Ώρες ειδοποίησης"

#: includes/admin_view.php:399
msgid "Suppress notifications"
msgstr "Καταστολή ειδοποιήσεων"

#: includes/admin_view.php:399
msgid "Suppressed alarms remain in history. Recovery notifications bypass acknowledgment, cooldown and duplicate suppression, but still follow notification hours and maintenance windows."
msgstr "Οι κατεσταλμένοι συναγερμοί παραμένουν στο ιστορικό. Οι ειδοποιήσεις αποκατάστασης παρακάμπτουν την επιβεβαίωση, τον χρόνο αναμονής και την καταστολή διπλοτύπων, αλλά εξακολουθούν να ακολουθούν τις ώρες ειδοποίησης και τα παράθυρα συντήρησης."

#: includes/admin_view.php:403
msgid "Set a duration to 0 to turn it off."
msgstr "Ορίστε τη διάρκεια σε 0 για απενεργοποίηση."

#: includes/admin_view.php:405
msgid "Rule order"
msgstr "Σειρά κανόνων"

#: includes/admin_view.php:408
msgid "Create rule"
msgstr "Δημιουργία κανόνα"

#: includes/admin_view.php:408
msgid "Rules with equal priority run in ID order. Stopping also applies when this rule suppresses notifications."
msgstr "Οι κανόνες με ίση προτεραιότητα εκτελούνται κατά σειρά αναγνωριστικού. Η διακοπή ισχύει επίσης όταν αυτός ο κανόνας καταστέλλει ειδοποιήσεις."

#: includes/admin_view.php:417
msgid "Configuration Backup/Restore"
msgstr "Αντίγραφο ασφαλείας/επαναφορά διαμόρφωσης"

#: includes/admin_view.php:427
msgid "Paused"
msgstr "Σε παύση"

#: includes/admin_view.php:427
msgid "Running"
msgstr "Τρέχουσες"

#: includes/admin_view.php:428
msgid "everything has been delivered"
msgstr "όλα έχουν παραδοθεί"

#: includes/admin_view.php:428
#, php-format
msgid "oldest queued %s UTC"
msgstr "παλαιότερο στην ουρά %s UTC"

#: includes/admin_view.php:428
msgid "waiting messages"
msgstr "μηνύματα σε αναμονή"

#: includes/admin_view.php:431
msgid "Hide messages"
msgstr "Απόκρυψη μηνυμάτων"

#: includes/admin_view.php:431
msgid "View messages"
msgstr "Προβολή μηνυμάτων"

#: includes/admin_view.php:441
msgid "Endpoint"
msgstr "Τελικό σημείο"

#: includes/admin_view.php:441
msgid "ID"
msgstr "ID"

#: includes/admin_view.php:441
msgid "Message"
msgstr "Μήνυμα"

#: includes/admin_view.php:441
msgid "Next try"
msgstr "Επόμενη προσπάθεια"

#: includes/admin_view.php:441 includes/reports.php:458
msgid "Queued"
msgstr "Στην ουρά"

#: includes/admin_view.php:441
msgid "Tries"
msgstr "Προσπάθειες"

#: includes/admin_view.php:451
msgid "Times in UTC · first 100 shown"
msgstr "Ώρες σε UTC · εμφανίζονται τα πρώτα 100"

#: includes/admin_view.php:455
msgid "Pause delivery"
msgstr "Παύση παράδοσης"

#: includes/admin_view.php:455
msgid "Resume delivery"
msgstr "Συνέχιση παράδοσης"

#: includes/admin_view.php:458
msgid "Clear queue"
msgstr "Εκκαθάριση ουράς"

#: includes/admin_view.php:459
#, php-format
msgid "Discard all %d waiting notifications on this poller?"
msgstr "Απόρριψη όλων των %d ειδοποιήσεων σε αναμονή σε αυτόν τον poller;"

#: includes/admin_view.php:460
msgid "Includes retries. They stay in delivery history as failed, reason queue_cleared."
msgstr "Περιλαμβάνει επαναλήψεις. Παραμένουν στο ιστορικό παραδόσεων ως αποτυχημένες με αιτία queue_cleared."

#: includes/admin_view.php:461
msgid "Messages already sending and alarm state are kept."
msgstr "Τα μηνύματα που ήδη αποστέλλονται και η κατάσταση των συναγερμών διατηρούνται."

#: includes/admin_view.php:462
msgid "Tip: pause delivery first during maintenance."
msgstr "Συμβουλή: κάντε πρώτα παύση παράδοσης κατά τη διάρκεια της συντήρησης."

#: includes/admin_view.php:463
msgid "Clear queue…"
msgstr "Εκκαθάριση ουράς…"

#: includes/admin_view.php:464
msgid "Controls apply to this poller. While paused, alarms are still received and queued; Resume sends them."
