msgid "The unit for the retention period."
msgstr "Enheten för lagringsperioden."

#: setup.php:191
msgid "Indefinitely"
msgstr "Ingen gräns"

#: setup.php:191
msgid "Months"
msgstr "Månader"

#: setup.php:191
msgid "Weeks"
