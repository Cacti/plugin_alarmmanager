#: alarmmanager_admin.php:50
msgid "The administration action succeeded."
msgstr "Hành động quản trị đã thành công."

#: alarmmanager_admin.php:86
msgid "Administration unavailable or permission denied."
msgstr "Quản trị không khả dụng hoặc bị từ chối quyền."

#: includes/admin_view.php:78
msgid "Choose the alarm information to send to any service. Use Combined text to arrange device details, or Use device message to start with a complete message. Email uses Subject and Message; API destinations use the field names required by the receiving service."
msgstr "Chọn thông tin cảnh báo để gửi tới bất kỳ dịch vụ nào. Dùng Văn bản kết hợp để sắp xếp chi tiết thiết bị, hoặc Dùng thông báo thiết bị để bắt đầu với một thông báo hoàn chỉnh. Email sử dụng Tiêu đề và Thông báo; các đích API sử dụng tên trường mà dịch vụ nhận yêu cầu."

#: includes/admin_view.php:79
msgid "Advanced message configuration"
msgstr "Cấu hình thông báo nâng cao"

#: includes/admin_view.php:90
msgid "New endpoint"
msgstr "Điểm cuối mới"

#: includes/admin_view.php:100
msgid "Custom integration"
msgstr "Tích hợp tùy chỉnh"

#: includes/admin_view.php:100
msgid "Integration provider"
msgstr "Nhà cung cấp tích hợp"

#: includes/admin_view.php:112
msgid "API Key SID and Secret (recommended)"
msgstr "API Key SID và Secret (khuyến nghị)"

#: includes/admin_view.php:112
msgid "Account SID and Auth Token"
msgstr "Account SID và Auth Token"

#: includes/admin_view.php:112
msgid "Twilio credentials"
msgstr "Thông tin xác thực Twilio"

#: includes/admin_view.php:113
msgid "Send using"
msgstr "Gửi bằng"

#: includes/admin_view.php:125
msgid "Event"
msgstr "Sự kiện"

#: includes/admin_view.php:125
msgid "Incident"
msgstr "Sự cố"

#: includes/admin_view.php:125
msgid "ServiceNow record type"
msgstr "Loại bản ghi ServiceNow"

#: includes/admin_view.php:126
msgid "Changing the record type replaces the destination table, message fields and recovery settings with its defaults. Your instance and credentials are retained."
msgstr "Thay đổi loại bản ghi sẽ thay thế bảng đích, các trường thông báo và cài đặt khôi phục bằng giá trị mặc định của nó. Phiên bản và thông tin xác thực của bạn vẫn được giữ nguyên."

#: includes/admin_view.php:149
msgid "Destination"
msgstr "Điểm đến"

#: includes/admin_view.php:154
msgid "Email settings"
msgstr "Cài đặt email"

#: includes/admin_view.php:161
msgid "Delivery uses the Cacti mail settings. Add the people who should receive these alarms."
msgstr "Việc gửi sử dụng cài đặt email của Cacti. Thêm những người sẽ nhận các cảnh báo này."

#: includes/admin_view.php:162
msgid "Script settings"
msgstr "Cài đặt tập lệnh"

#: includes/admin_view.php:167
msgid "JSON output is sent to the script on standard input."
msgstr "Đầu ra JSON được gửi tới tập lệnh qua đầu vào chuẩn."

#: includes/admin_view.php:167
msgid "The executable must exist and be executable by the worker on every delivering poller. Arguments are passed directly without a shell."
msgstr "Tệp thực thi phải tồn tại và worker có quyền thực thi trên mọi poller thực hiện gửi. Các tham số được truyền trực tiếp mà không qua shell."

#: includes/admin_view.php:169
msgid "WebSocket delivery is not implemented."
msgstr "Chưa triển khai việc gửi qua WebSocket."

#: includes/admin_view.php:171
msgid "Advanced delivery settings"
msgstr "Cài đặt gửi nâng cao"

#: includes/admin_view.php:176
msgid "Connection options"
msgstr "Tùy chọn kết nối"

#: includes/admin_view.php:179
msgid "Method"
msgstr "Phương thức"

#: includes/admin_view.php:186
msgid "Certificate and hostname verification remain enabled. Provision the PEM file on every poller. Saved credentials are never displayed."
msgstr "Xác minh chứng chỉ và tên máy chủ vẫn được bật. Cung cấp tệp PEM trên mọi poller. Thông tin xác thực đã lưu không bao giờ được hiển thị."

#: includes/admin_view.php:187
msgid "Other delivery options"
msgstr "Các tùy chọn gửi khác"

#: includes/admin_view.php:189 includes/admin_view.php:458
msgid "Cancel"
msgstr "Hủy"

#: includes/admin_view.php:189
msgid "Test destination saves the current settings and queues a sample alarm for this destination. Enable the destination before testing."
msgstr "Kiểm tra đích gửi sẽ lưu cài đặt hiện tại và xếp hàng một cảnh báo mẫu cho đích này. Hãy bật đích gửi trước khi kiểm tra."

#: includes/admin_view.php:190
msgid "Save endpoint"
msgstr "Lưu điểm cuối"

#: includes/admin_view.php:190
msgid "Test destination"
msgstr "Kiểm tra đích gửi"

#: includes/admin_view.php:194
msgid "Delete endpoint"
msgstr "Xóa điểm cuối"

#: includes/admin_view.php:194
msgid "Delete this endpoint, its delivery settings and saved credentials"
msgstr "Xóa điểm cuối này, cài đặt gửi và thông tin xác thực đã lưu của nó"

#: includes/admin_view.php:194
msgid "Deleting stops future delivery and removes the saved settings and credentials. Remove notification rule references and resolve queued or running deliveries first. Completed and failed delivery history is preserved."
msgstr "Xóa sẽ dừng các lần gửi trong tương lai và xóa cài đặt cùng thông tin xác thực đã lưu. Hãy gỡ bỏ các tham chiếu quy tắc thông báo và xử lý các lần gửi đang xếp hàng hoặc đang chạy trước. Lịch sử gửi đã hoàn thành và thất bại vẫn được giữ lại."

#: includes/admin_view.php:205
msgid "Chat and messaging"
msgstr "Trò chuyện và nhắn tin"

#: includes/admin_view.php:206
msgid "Post alarms to a Slack channel."
msgstr "Đăng cảnh báo tới một kênh Slack."

#: includes/admin_view.php:207
msgid "Post alarm cards through a Teams Workflow."
msgstr "Đăng thẻ cảnh báo thông qua Teams Workflow."

#: includes/admin_view.php:208
msgid "Send alarms from a Telegram bot."
msgstr "Gửi cảnh báo từ bot Telegram."

#: includes/admin_view.php:209
msgid "Text alarms to phone numbers."
msgstr "Nhắn tin cảnh báo tới số điện thoại."

#: includes/admin_view.php:210
msgid "Send approved WhatsApp templates."
msgstr "Gửi các mẫu WhatsApp đã được phê duyệt."

#: includes/admin_view.php:211
msgid "Incident management"
msgstr "Quản lý sự cố"

#: includes/admin_view.php:212
msgid "Trigger and resolve PagerDuty incidents."
msgstr "Kích hoạt và giải quyết sự cố PagerDuty."

#: includes/admin_view.php:213
msgid "Open and resolve ServiceNow incidents or events."
msgstr "Mở và giải quyết sự cố hoặc sự kiện ServiceNow."

#: includes/admin_view.php:214
msgid "Network management"
msgstr "Quản lý mạng"

#: includes/admin_view.php:215
msgid "Send SNMPv2c or SNMPv3 traps and INFORMs."
msgstr "Gửi bẫy và INFORM SNMPv2c hoặc SNMPv3."

#: includes/admin_view.php:216
msgid "Forward RFC 5424 or RFC 3164 messages over UDP, TCP or TLS."
msgstr "Chuyển tiếp thông điệp RFC 5424 hoặc RFC 3164 qua UDP, TCP hoặc TLS."

#: includes/admin_view.php:217
msgid "Custom"
msgstr "Tùy chỉnh"

#: includes/admin_view.php:218
msgid "Start from an empty endpoint."
msgstr "Bắt đầu từ một điểm cuối trống."

#: includes/admin_view.php:219
msgid "POST alarm JSON to any HTTPS endpoint."
msgstr "Gửi POST JSON cảnh báo tới bất kỳ điểm cuối HTTPS nào."

#: includes/admin_view.php:220
msgid "Call an API with your own method, authentication and response checks."
msgstr "Gọi API bằng phương thức, xác thực và kiểm tra phản hồi của riêng bạn."

#: includes/admin_view.php:221
msgid "Run a local executable with the alarm as JSON input."
msgstr "Chạy tệp thực thi cục bộ với cảnh báo ở dạng đầu vào JSON."

#: includes/admin_view.php:227
msgid "Add integration"
msgstr "Thêm tích hợp"

#: includes/admin_view.php:228
msgid "Choose a template. It opens as a disabled draft; nothing is sent until you enable it."
msgstr "Chọn một mẫu. Mẫu sẽ mở ở dạng bản nháp đang tắt; không có gì được gửi cho đến khi bạn bật nó."

#: includes/admin_view.php:228
msgid "Search integrations"
msgstr "Tìm kiếm tích hợp"

#: includes/admin_view.php:234
msgid "Blank endpoint"
msgstr "Điểm cuối trống"

#: includes/admin_view.php:239
msgid "No integrations match your search."
msgstr "Không có tích hợp nào khớp với tìm kiếm của bạn."

#: includes/admin_view.php:243
msgid "SNMP trap settings"
msgstr "Cài đặt bẫy SNMP"

#: includes/admin_view.php:259
msgid "Saved community and passphrases are encrypted and never displayed. Leave them blank to keep the saved values; entering any value replaces all saved SNMP secrets."
msgstr "Chuỗi cộng đồng và cụm mật khẩu đã lưu được mã hóa và không bao giờ hiển thị. Để trống để giữ nguyên giá trị đã lưu; nhập bất kỳ giá trị nào sẽ thay thế toàn bộ bí mật SNMP đã lưu."

#: includes/admin_view.php:260
msgid "Traps are sent as Cacti's CACTI-MIB cactiNotify with the snmptrap binary from Cacti Settings > Paths on every delivering poller. Add one destination per receiver."
msgstr "Bẫy được gửi dưới dạng CACTI-MIB cactiNotify của Cacti bằng tệp thực thi snmptrap từ Cài đặt Cacti > Đường dẫn trên mọi poller thực hiện gửi. Thêm một đích cho mỗi bên nhận."

#: includes/admin_view.php:261
msgid "Syslog settings"
msgstr "Cài đặt Syslog"

#: includes/admin_view.php:269
msgid "TLS verifies the receiver certificate and hostname. Use port 6514 for TLS. UDP and TCP are unencrypted, and a UDP message is confirmed only as sent."
msgstr "TLS xác minh chứng chỉ và tên máy chủ của bên nhận. Dùng cổng 6514 cho TLS. UDP và TCP không được mã hóa, và thông điệp UDP chỉ được xác nhận là đã gửi."

#: includes/admin_view.php:278 setup.php:191
msgid "Days"
msgstr "Ngày"

#: includes/admin_view.php:283
msgid "Timezone"
msgstr "Múi giờ"

#: includes/admin_view.php:291
msgid "Times use the selected timezone and the alarm event time. An end time before the start runs overnight. Equal times cover the entire selected day."
msgstr "Thời gian sử dụng múi giờ đã chọn và thời điểm sự kiện cảnh báo. Thời gian kết thúc sớm hơn thời gian bắt đầu sẽ chạy qua đêm. Thời gian bằng nhau sẽ áp dụng cho cả ngày đã chọn."

#: includes/admin_view.php:332 includes/admin_view.php:521
msgid "Create a rule"
msgstr "Tạo quy tắc"

#: includes/admin_view.php:332
msgid "Enabled"
msgstr "Bật"

#: includes/admin_view.php:332
msgid "Priority"
msgstr "Ưu tiên"

#: includes/admin_view.php:334
msgid "Rule and destination"
msgstr "Quy tắc và đích gửi"

#: includes/admin_view.php:338
msgid "Alarm Destination"
msgstr "Đích nhận cảnh báo"

#: includes/admin_view.php:341
msgid "disabled"
msgstr "đã tắt"

#: includes/admin_view.php:343
msgid "Select one or more alarm destinations. Disabled destinations do not send alarms."
msgstr "Chọn một hoặc nhiều đích gửi cảnh báo. Các đích đang tắt sẽ không gửi cảnh báo."

#: includes/admin_view.php:345
msgid "Message template"
msgstr "Mẫu thông báo"

#: includes/admin_view.php:345
msgid "Use each destination default, or customize its message for this rule. Customization starts with a copy of the destination template and does not change other rules. If several rules match the same destination, the first matching rule in priority and ID order supplies its template."
msgstr "Dùng mặc định của từng đích gửi hoặc tùy chỉnh thông báo cho quy tắc này. Việc tùy chỉnh bắt đầu từ bản sao của mẫu đích gửi và không làm thay đổi các quy tắc khác. Nếu nhiều quy tắc khớp với cùng một đích gửi, quy tắc khớp đầu tiên theo thứ tự ưu tiên và ID sẽ cung cấp mẫu."

#: includes/admin_view.php:352
msgid "Custom template"
msgstr "Mẫu tùy chỉnh"

#: includes/admin_view.php:355
msgid "Destination recipient"
msgstr "Người nhận đích"

#: includes/admin_view.php:355
#, php-format
msgid "Recipients: %d"
msgstr "Người nhận: %d"

#: includes/admin_view.php:357
msgid "Customize message for this rule"
msgstr "Tùy chỉnh thông báo cho quy tắc này"

#: includes/admin_view.php:357
msgid "Unchecked: Use destination default."
msgstr "Bỏ chọn: Dùng mặc định của đích gửi."

#: includes/admin_view.php:361
msgid "Optional: add each phone number in international format, such as +15551234567. These numbers replace the destination recipient for this rule. Leave the list empty to use the destination default. Each number has its own delivery status and retries."
msgstr "Tùy chọn: thêm từng số điện thoại theo định dạng quốc tế, chẳng hạn như +15551234567. Các số này sẽ thay thế người nhận đích cho quy tắc này. Để trống danh sách để dùng giá trị mặc định của đích. Mỗi số có trạng thái gửi và số lần thử lại riêng."

#: includes/admin_view.php:374
msgid "None"
msgstr "Không"

#: includes/admin_view.php:376
msgid "Build device conditions using AND, OR and groups. These conditions use the current Cacti device settings and must also satisfy any alarm filters below. With no device conditions, all devices can match."
msgstr "Xây dựng điều kiện thiết bị bằng AND, OR và các nhóm. Các điều kiện này sử dụng cài đặt thiết bị Cacti hiện tại và cũng phải đáp ứng mọi bộ lọc cảnh báo bên dưới. Nếu không có điều kiện thiết bị, tất cả thiết bị đều có thể khớp."

#: includes/admin_view.php:376
msgid "Match devices"
msgstr "Khớp thiết bị"

#: includes/admin_view.php:387
msgid "Cacti_Admin_Notifications"
msgstr "Cacti_Admin_Notifications"

#: includes/admin_view.php:387
msgid "Device Status"
msgstr "Tình trạng thiết bị"

#: includes/admin_view.php:387
msgid "Syslog"
msgstr "Syslog"

#: includes/admin_view.php:387
msgid "Thold"
msgstr "Thold"

#: includes/admin_view.php:392
msgid "Build alarm conditions using AND, OR, NOT and groups. Alarms must also match the device conditions above."
msgstr "Xây dựng điều kiện cảnh báo bằng AND, OR, NOT và các nhóm. Cảnh báo cũng phải khớp với điều kiện thiết bị ở trên."

#: includes/admin_view.php:392
msgid "Match alarms"
msgstr "Khớp cảnh báo"

#: includes/admin_view.php:395
msgid "No alarm sources detected yet. Sources appear after their first alarm."
msgstr "Chưa phát hiện nguồn cảnh báo nào. Nguồn sẽ xuất hiện sau cảnh báo đầu tiên."

#: includes/admin_view.php:397
msgid "By default, matching alarms can notify at any time. Turn on a schedule to limit when this rule matches."
msgstr "Theo mặc định, các cảnh báo khớp điều kiện có thể gửi thông báo bất kỳ lúc nào. Bật lịch trình để giới hạn thời điểm quy tắc này khớp."

#: includes/admin_view.php:397
msgid "Notification hours"
msgstr "Giờ gửi thông báo"

#: includes/admin_view.php:399
msgid "Suppress notifications"
msgstr "Chặn thông báo"

#: includes/admin_view.php:399
msgid "Suppressed alarms remain in history. Recovery notifications bypass acknowledgment, cooldown and duplicate suppression, but still follow notification hours and maintenance windows."
msgstr "Các cảnh báo bị chặn vẫn nằm trong lịch sử. Thông báo khôi phục bỏ qua xác nhận, thời gian chờ và chặn trùng lặp, nhưng vẫn tuân theo giờ gửi thông báo và khung thời gian bảo trì."

#: includes/admin_view.php:403
msgid "Set a duration to 0 to turn it off."
msgstr "Đặt thời lượng thành 0 để tắt."

#: includes/admin_view.php:405
msgid "Rule order"
msgstr "Thứ tự quy tắc"

#: includes/admin_view.php:408
msgid "Create rule"
msgstr "Tạo quy tắc"

#: includes/admin_view.php:408
msgid "Rules with equal priority run in ID order. Stopping also applies when this rule suppresses notifications."
msgstr "Các quy tắc có cùng mức ưu tiên sẽ chạy theo thứ tự ID. Việc dừng cũng áp dụng khi quy tắc này chặn thông báo."

#: includes/admin_view.php:417
msgid "Configuration Backup/Restore"
msgstr "Sao lưu/Khôi phục cấu hình"

#: includes/admin_view.php:427
msgid "Paused"
msgstr "Đã tạm dừng"

#: includes/admin_view.php:427
msgid "Running"
msgstr "Đang chạy"

#: includes/admin_view.php:428
msgid "everything has been delivered"
msgstr "tất cả đã được gửi"

#: includes/admin_view.php:428
#, php-format
msgid "oldest queued %s UTC"
msgstr "xếp hàng cũ nhất %s UTC"

#: includes/admin_view.php:428
msgid "waiting messages"
msgstr "thông báo đang chờ"

#: includes/admin_view.php:431
msgid "Hide messages"
msgstr "Ẩn thông báo"

#: includes/admin_view.php:431
msgid "View messages"
msgstr "Xem thông báo"

#: includes/admin_view.php:441
msgid "Endpoint"
msgstr "Điểm cuối"

#: includes/admin_view.php:441
msgid "ID"
msgstr "ID"

#: includes/admin_view.php:441
msgid "Message"
msgstr "Tin nhắn"

#: includes/admin_view.php:441
msgid "Next try"
msgstr "Lần thử tiếp theo"

#: includes/admin_view.php:441 includes/reports.php:458
msgid "Queued"
msgstr "Đang xếp hàng"

#: includes/admin_view.php:441
msgid "Tries"
msgstr "Số lần thử"

#: includes/admin_view.php:451
msgid "Times in UTC · first 100 shown"
msgstr "Thời gian theo UTC · hiển thị 100 bản ghi đầu tiên"

#: includes/admin_view.php:455
msgid "Pause delivery"
msgstr "Tạm dừng gửi"

#: includes/admin_view.php:455
msgid "Resume delivery"
msgstr "Tiếp tục gửi"

#: includes/admin_view.php:458
msgid "Clear queue"
msgstr "Xóa hàng đợi"

#: includes/admin_view.php:459
#, php-format
msgid "Discard all %d waiting notifications on this poller?"
msgstr "Hủy bỏ tất cả %d thông báo đang chờ trên poller này?"

#: includes/admin_view.php:460
msgid "Includes retries. They stay in delivery history as failed, reason queue_cleared."
msgstr "Bao gồm cả các lần thử lại. Chúng vẫn nằm trong lịch sử gửi ở trạng thái thất bại với lý do queue_cleared."

#: includes/admin_view.php:461
msgid "Messages already sending and alarm state are kept."
msgstr "Các thông báo đang được gửi và trạng thái cảnh báo vẫn được giữ nguyên."

#: includes/admin_view.php:462
msgid "Tip: pause delivery first during maintenance."
msgstr "Mẹo: hãy tạm dừng gửi trước trong thời gian bảo trì."

#: includes/admin_view.php:463
msgid "Clear queue…"
msgstr "Đang xóa hàng đợi…"

#: includes/admin_view.php:464
msgid "Controls apply to this poller. While paused, alarms are still received and queued; Resume sends them."
msgstr "Các điều khiển áp dụng cho poller này. Khi tạm dừng, cảnh báo vẫn được nhận và đưa vào hàng đợi; Tiếp tục sẽ gửi chúng đi."

#: includes/admin_view.php:467
msgid "View delivery results"
msgstr "Xem kết quả gửi"

#: includes/admin_view.php:470
msgid "Create an integration, configure its destination and credentials, test a sample alarm here, then select it directly in a rule."
msgstr "Tạo một tích hợp, cấu hình đích gửi và thông tin xác thực, thử nghiệm một cảnh báo mẫu tại đây, sau đó chọn trực tiếp trong một quy tắc."

#: includes/admin_view.php:476
msgid "Configured integrations"
msgstr "Các tích hợp đã cấu hình"

#: includes/admin_view.php:479
msgid "No integrations yet. Choose a template above to create one."
