# Operating system files
.DS_Store
Thumbs.db

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# Logs and temporary files
*.log
/tmp/
/temp/

# Test and analysis output
/coverage/
.phpunit.result.cache
.phpunit.cache/

# Vendored libraries must remain tracked; do not ignore vendor/.

# Locally provisioned private keys and Python bytecode
*.key
__pycache__/
*.pyc

.php-cs-fixer.cache
.phpstan-tmp-cache/

# docs/ working notes live outside version control; only benchmark fixtures
# and index.php guards belong under docs/
docs/*.md
docs/benchmarks/*.md
docs/benchmarks/*.html
